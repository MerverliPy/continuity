{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.local/schemas/v1/evidence-index.schema.json",
  "title": "Continuity v1 evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "continuity.evidence-index/v1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceItem"},
      "uniqueItems": true
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceState": {
      "type": "string",
      "enum": ["Verified", "Asserted", "Unresolved", "Contradicted", "Missing"]
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "state", "reference"],
      "properties": {
        "source_id": {"$ref": "#/$defs/stableId"},
        "state": {"$ref": "#/$defs/evidenceState"},
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
